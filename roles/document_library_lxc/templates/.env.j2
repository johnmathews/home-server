# vim: ft=jinja2
# Common settings

TZ={{ tz }}

###############################################################################
# Library settings (github.com/johnmathews/library)                          #
###############################################################################

# Internal docker-network credential for library-db (compose interpolates it).
LIBRARY_DB_PASSWORD={{ vault_library_db_password }}
{% if vault_library_anthropic_api_key is defined %}
# Claude API key for metadata extraction (from ansible vault). When absent,
# documents still OCR and index — extraction is skipped gracefully.
#
# This is the ONLY place the key is set. It used to be duplicated into the
# `environment:` blocks of library-webserver and library-worker, which silently
# won over this file — so changing the vault value did not reach the containers.
LIBRARY_ANTHROPIC_API_KEY={{ vault_library_anthropic_api_key }}
{% endif %}

# Which transport library's Ask feature uses to reach Claude. The image
# defaults to "subscription" (Claude Code CLI + the OAuth credentials mounted
# at /app/.claude); the live value is an admin-editable setting stored in the
# database, so this is only the fallback when no override exists.
#
# Uncomment to pin Ask to the metered API — needed on a host where
# `claude auth login` has not been run yet, since otherwise Ask has no
# credentials and every question fails. See library docs/llm-backends.md.
#LIBRARY_ASK_LLM_BACKEND=api


###############################################################################
# Observability                                                               #
###############################################################################

# Serve GET /metrics for Prometheus to scrape (OpenTelemetry metrics about the
# Ask surface: tokens split by cache kind, cost, latency, tool-loop depth,
# errors). Unauthenticated, like /healthz.
#
# Off by default in the image, so this line is what turns it on. While disabled
# the endpoint returns 404 rather than an empty 200 — an empty exposition is
# indistinguishable from a healthy scrape collecting nothing.
#
# Scraped by prometheus_lxc's `library` job on the PUBLISHED port 8010 (the
# container listens on 8000; compose maps 8010:8000).
#
# See library docs/observability.md.
LIBRARY_OTEL_METRICS_ENABLED=true

# Claude Code's own CLI telemetry for the subscription backend is deliberately
# NOT enabled here: it needs an OTLP collector, which this network does not run
# (Prometheus scrapes, it does not receive pushes). If one is ever added, set
# LIBRARY_CLAUDE_CODE_TELEMETRY_ENABLED and LIBRARY_OTEL_EXPORTER_OTLP_ENDPOINT
# together — and note the app REFUSES to start if any OTEL_LOG_* content
# variable is set, because those export prompt/response/tool content, which for
# Ask is the text of the documents themselves.


LIBRARY_EMAIL_HOST=imap.gmail.com
LIBRARY_EMAIL_USERNAME={{ vault_library_gmail_email_address }}
LIBRARY_EMAIL_PASSWORD={{ vault_library_gmail_app_password }}
LIBRARY_EMAIL_POLL_MINUTES=10


# Public base URL of the web app (no trailing slash). Used to deep-link
# Pushover push notifications back to the document they refer to, so tapping
# a notification opens it in the app. Strongly recommended in production —
# unset = notifications arrive with no link (and the app logs a warning at
# startup). Set it to however you reach the web app from your phone.
LIBRARY_PUBLIC_BASE_URL={{ vault_library_public_base_url }} 
