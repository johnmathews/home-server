# vim: ft=jinja2
# {{ ansible_managed }}
# Common settings

TZ={{ TZ }}

###############################################################################
# Family finances (github.com/johnmathews/family-finances)                    #
###############################################################################

# The invitation code needed to create a household. Registration is CLOSED
# when this is empty — that is the safe direction, and the one the test suite
# asserts (docs/adr/0016-invite-only-registration.md). If signup starts
# returning 403 for someone who should be able to register, check this first.
#
# Mode 0600, and the value comes from the vault: the compose file is
# world-readable on the host, so it must not carry the code itself.
FAMILY_FINANCES_SIGNUP_CODE={{ family_finances_lxc_family_finances_signup_code }}

# Bank sync over PSD2. All three unset means sync is off, and the Banks screen
# says so rather than offering a button that cannot work.
#
# The application id is not a secret in the way the signup code is -- it is
# visible in the provider's portal -- but it identifies a credential, and this
# file is 0600 while the compose file beside it is world-readable.
ENABLE_BANKING_APP_ID={{ family_finances_lxc_enable_banking_app_id }}
ENABLE_BANKING_PRIVATE_KEY_FILE=/secrets/enable-banking.pem
ENABLE_BANKING_REDIRECT_URL={{ family_finances_lxc_enable_banking_redirect_url }}
