# vim: ft=jinja2
# {{ ansible_managed }}
# Common settings

TZ={{ TZ }}

###############################################################################
# Family finances (github.com/johnmathews/family-finances)                    #
###############################################################################

# The invitation code needed to create a household. Registration is CLOSED
# when this is empty — that is the safe direction, and the one the test suite
# asserts (docs/adr/0016-invite-only-registration.md). If signup starts
# returning 403 for someone who should be able to register, check this first.
#
# Mode 0600, and the value comes from the vault: the compose file is
# world-readable on the host, so it must not carry the code itself.
FAMILY_FINANCES_SIGNUP_CODE={{ family_finances_signup_code }}
